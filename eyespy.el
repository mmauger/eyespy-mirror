;;; Commentary:

;; Although Emacs has an integrated elisp debugger, sometimes it is
;; easier to debug what is happening in a function by just displaying
;; the value of a variable in the midst of running code.  Some of us
;; are easily distracted (*cough* ADHD *cough*) and we forget what we
;; were doing between realizing that there is an error, instrumenting
;; the function for debugging, and then relaunching the failing
;; function again.  By leaving a breadcrumb in the code itself and in
;; the `*Messages*' buffer, we are reminded two days later of the
;; problem we originally encountered before we had embarked on several
;; unrelated side quests.  To minimize the impact to running code, this function simply just prints the value of an expression in the *Messages* buffer, and avoids pausing execution or significantly interfering with display
;; processing.  And finally, to simplify identifying debugging code
;; and messages generated by such code, the macro to invoke the
;; debugging messaging is a visible Unicode character, and the
;; messages are preceded by that character as well.

;; As an example, eyespy messaging can be invoked as follows:
;;
;;     (defun example-function (alpha beta)
;;       "This is an example of a function taking ALPHA and BETA parameters."
;;       (👀 "My system is %s" system-type)
;;       (👀 alpha beta (+ (if alpha 100 10) beta))
;;       (if alpha
;;           (+ beta 100)
;;         (👀 "Alpha is nil")
;;         (+ beta 10)))
;;
;; If the function `example-function' were invoked as follows:
;;
;;      (example-function "meaningful alpha text" 27)
;;        ⇒ 127
;;      (example-function nil 27)
;;        ⇒ 37
;;
;; the *Messages* buffer will contain:
;;
;;      👀 (example-function "meaningful alpha text" 27)  ⟼  My system is gnu/linix
;;      👀 (example-function "meaningful alpha text" 27)  ⟼  alpha="meaningful alpha text" · beta=27 · (+ (if alpha 100 10) beta)=127
;;
;;      👀 (example-function nil 27)  ⟼  My system is gnu/linix
;;      👀 (example-function nil 27)  ⟼  alpha=nil · beta=27 · (+ (if alpha 100 10) beta)=37
;;      👀 (example-function nil 27)  ⟼  Alpha is nil
;;

;; The `eyespy-message' function, which the `👀' macro invokes, has
;; the following behavior:
;;
;; + The message line will be prefixed by the macro name.
;;
;; + Following the macro name will be the calling function and it's
;; parameter's values.
;;
;; + There will then be an arrow to point out the message being
;; displayed.
;;
;; + If the macro is invoked and the first parameter is a string
;; literal, then it operates the same way that `message' or `format'
;; does—the first parameter is a formatting string and the remainder
;; of the parameters as substituted into the output according to the
;; formatting rules.
;;
;; + If the first parameter to the macro is not a string literal, then
;; each parameter is formatted with the parameter text followed by
;; it's evaluated value.  Any nil literal parameters are ignored, so
;; that the first parameter can be nil to force this second style of
;; formatting.
;;
;; + The evaluated parameters of the macro are returned by the macro.
;; If there is only one evaluated parameter then it is returned
;; directly; multiple parameters are returned in a list.  Thus you can
;; surround expressions with a macro expression and it will appear in
;; the `*Messages*' buffer and will return its value to the
;; encompassing expression.  For example, below, the values of `gamma'
;; and `epsilon' will appear in the `*Messages*' buffer, but their
;; values will be passed through to the surrounding expression as if
;; the eyespy messaging wasn't present.
;;
;;      (let ((gamma 11)
;;            (epsilon  33))
;;        (+ (👀 gamma) (👀 epsilon)))
;;        ⇒ 44
;;
;; In the `*Messages*' buffer:
;;
;;      👀 eval  ⟼  gamma=11
;;      👀 eval  ⟼  epsilon=33
;;
;; The use of the eyespy icon as the macro for messaging makes
;; locating these debugging calls in code easy to find with a simple
;; `grep' command, and also prefixing messages with the icon makes
;; finding them in the `*Messages*' buffer simple with
;; \\[isearch-forward] or \\[occur].

;;; Code:

(require 'backtrace)
(require 'cl-lib)
(require 'rx)
(require 'skeleton)

(defgroup eyespy nil
  "Display the value of elisp variables by generating messages."
  :prefix "eyespy-"
  :group 'lisp)

;; Mark functions as potential callers, or not
(defun eyespy-make-caller (func)
  "Mark FUNC as a caller for eyespy-caller purposes."
  (put func 'eyespy-caller-function t))

(defun eyespy-make-not-caller (func)
  "Mark FUNC as /not/ a caller for eyespy-caller purposes."
  (put func 'eyespy-caller-function nil))

(defun eyespy-caller-p (func &optional not)
  "Is FUNC a caller, or NOT."
  (let* ((has-caller  (plist-member (symbol-plist func) 'eyespy-is-caller))
         (caller-val  (cadr has-caller)))
    (when has-caller
      (eq caller-val (null not)))))

;; Is this function from this module
(defun eyespy-this-is-not-the-caller (func)
  "Is FUNC part of this module?

Compare the filename sans the extension (.el, .elc, .eln).  Also check
the `eyespy-is-caller' property for special cases."
  (let ((eyespy-file (symbol-file 'eyespy-message))
	(func-file   (symbol-file func)))
    (or (eyespy-caller-p func :not)
        (and eyespy-file
	     func-file
	     (string= (file-name-sans-extension func-file)
		      (file-name-sans-extension eyespy-file))))))

;; System functions that represent evaluation so that "eval" becomes the caller
(defcustom eyespy-eval-functions '(elisp--eval-last-sexp
                                   eval-print-last-sexp
                                   pp-eval-expression
                                   pp-eval-last-sexp)
  "Functions that indicate that the code is being explicitly evaluated."
  :type '(repeat function))

(defun eyespy-make-eval (func)
  "Mark FUNC as an evaluator for eyespy-caller."
  (push func eyespy-eval-functions))

;; Does a function match a list of symbols, or does its name match a regexp?
;;;###autoload
(defcustom eyespy-caller-matchers nil
  "A list of function symbols or regexp that identify calling functions."
  :type '(repeat
          (choice (string :tag "Regexp to match function name")
                  (function :tag "Matched function"))))

(defun eyespy--match (func matchers)
  "Internal: match FUNC to one of the MATCHERS."
  (when-let* ((this-matcher  (car matchers))
              (tail-matchers (cdr matchers)))
    (or (and (symbolp this-matcher)
             (eq func this-matcher))
        (and (stringp this-matcher)
             (string-match-p this-matcher (symbol-name func)))
        (eyespy--match func tail-matchers))))

(defun eyespy-match-caller (func)
  "Does FUNC match any entries in `eyespy-caller-matchers'."
  (and eyespy-caller-matchers
       (eyespy--match func eyespy-caller-matchers)))

;; Identify functions that are not from Emacs itself
(defun eyespy--is-system-function (func-file-name folders)
  "Internal: Is the FUNC-FILE-NAME in any of the FOLDERS trees?"
  (when folders
    (or (string-prefix-p (car folders) func-file-name)
        (eyespy--is-system-function func-file-name (cdr folders)))))

(defun eyespy-non-system-caller (func)
  "Does FUNC is not in the distribution or ELPA folder."
  (let* ((system-folders (list
                          installation-directory
                          (file-name-directory invocation-directory)
                          package-user-dir
                          (mapcar #'file-name-parent-directory package-directory-list)))
         (folder-list (delete-dups (mapcar #'expand-file-name (flatten-list system-folders))))
         (func-src (symbol-file func 'defun)))
    (and func-src ;; is not Emacs core C code
         (not (eyespy--is-system-function func-src folder-list)))))

;;;###autoload
(defcustom eyespy-is-caller-functions '(eyespy-caller-p
                                        eyespy-match-caller
                                        eyespy-non-system-caller)
  "A list of functions to decide whether the backtrace is the caller.

Each function is called with the function symbol of a back trace frame.
If a function on the list returns a non-nil, no further tests are made.
`eyespy-is-this-the-caller' is responsible for this process."
  :type '(repeat function))

(defun eyespy--check (func checkers)
  "Internal: check FUNC in each CHECKERS function."
  (when checkers
    (or (funcall (car checkers) func)
        (eyespy--check func (cdr checkers)))))

(defun eyespy-is-this-the-caller (func)
  "Is this FUNC the likely caller of the trace function."
  (and eyespy-is-caller-functions
       (eyespy--check func eyespy-is-caller-functions)))

;; Loop through the backtrace frames looking for the caller
;;;###autoload
(defun eyespy-caller ()
  "Display the meaningful caller."
  (catch 'caller
    ;; go back thru frames starting with caller of the log function
    (dolist (frame (cdr (backtrace-get-frames)))
      (let* ((func (backtrace-frame-fun frame))
             (args (backtrace-frame-args frame)))
        (when (symbolp func)
          ;; (message "» %S: %s" (cons func args) (symbol-file func))
          (cond
           ;; ignore eyespy functions;
           ;; we can't use eyespy on eyespy...
           ((eyespy-this-is-not-the-caller func)
            nil)
           ;; did we C-x C-e the expression
           ((memq func eyespy-eval-functions)
            (throw 'caller 'eval))
           ;; Is function the caller
           ((eyespy-is-this-the-caller func)
            (throw 'caller (cons func args)))))))))

;; Define the icon symbol to identify the eyespy messaging function and it's messages
;;;###autoload
(defun eyespy--customize-set-icon (option value)
  "Set the eyespy OPTION (icon) to VALUE, and define macro to emit a message.

To avoid duplicate messages and repeated definition of the macro, only
process if the VALUE has changed."
  (let ((old-value (ignore-errors
                      (default-toplevel-value option))))
    (unless (eq value old-value)
      (set-default-toplevel-value option value)
      ;; Erase the old macro; define the new one
      (when old-value
        (makunbound old-value))
      (makunbound value)
      (eval `(defmacro ,value (fmt &rest args)
               ,(format "Calls `eyespy-message' with %S and (FMT . ARGS)." value)
               (eyespy-message (quote ,value) (cons fmt args))))
      ;; Announce the new setting
      (message "Eyespy with my little %s..." value))
    value))

;;;###autoload
(defcustom eyespy-icon '👀
  "The command for eyespy messaging and the prefix in the `*Messages*' buffer."
  :set #'eyespy--customize-set-icon
  :initialize #'custom-initialize-set
  :type 'symbol)

;;;###autoload
(defun eyespy-insert ()
  "Insert a call to the trace message macro.

If there is an active region, insert the region as the expression passed
to `eyespy-message'.  If there is no region, select the expression at
point instead.  If there is still no region, leave the cursor in the
`eyespy-message' call.

If a region is inserted into the call, and we're not at the end of the
line, skip forward to the next expression.

Bind this to a function key to easily insert an eyespy message."
  (interactive)
  ;; If nothing is selected, try to select the sexpr
  (unless (use-region-p)
    (when-let* ((bounds (bounds-of-thing-at-point 'sexp)))
      (push-mark (car bounds) t t)
      (goto-char (cdr bounds))))
  ;; insert the call to the macro, wrapping around the selected region
  (let (skeleton-end-newline)
    (skeleton-insert '(nil "(" (symbol-name eyespy-icon) "\s" _ ")")
                     (when (use-region-p) -1)))
  (pop-mark)
  ;; If not at the end of the line (ignoring spaces and comments)
  (unless (looking-at-p (rx (0+ space)
                            (optional (literal comment-start) (0+ any))
                            eol))
    ;; skip forward to the next sexp on the line
    (let ((here (point)))
      (condition-case nil
          (progn
            (forward-sexp)
            (unless (= (point) here)
              (backward-sexp)))
        (scan-error nil)))))

;; The eyespy messaging function that generates the macro code that
;; produces the actual message.
;;;###autoload
(defun eyespy-message (icon args)
  "Display message ARGS preceded by ICON and the function name."
  ;; Generate suitable `fmt' and `args' values
  (let (fmt)
    (if (stringp (car args))
        ;; `message'-like parameters
        (setq fmt (car args)
              args (cdr args))
      ;; Each non-nil parameter has a format
      (setq args (cl-remove-if #'not args)
            fmt (mapconcat
                 (lambda (arg) (format "%s=%%S" arg))
                 args
                 " \N{Middle Dot} ")))
    ;; Generate the macro code to message the caller and args
    (let* ((varg (gensym))
           (retval (if (cdr args) varg (list 'car varg))))
      `(let* ((message-truncate-lines t)
              print-length
              print-level
              (,varg (list ,@args)))
         (apply #'message ,(concat "%s %S  \N{Long Rightwards Arrow From Bar}  " fmt)
                (quote ,icon) (eyespy-caller) ,varg)
         ,retval))))

(provide 'eyespy)
; LocalWords:  eyespy
;;; eyespy.el ends here
